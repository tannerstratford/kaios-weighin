{
  "name": "WeighIn",
  "short_name": "WeighIn",
  "description": "Weight, BMI and trends from a Bluetooth broadcast scale",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "lang": "en-US",
  "scope": "/",
  "orientation": "portrait",
  "id": "weighin",
  "version": "1.3",
  "icons": [
    { "src": "/icons/icon_56.png", "type": "image/png", "sizes": "56x56" },
    { "src": "/icons/icon_112.png", "type": "image/png", "sizes": "112x112" }
  ],
  "b2g_features": {
    "focus_color": "#2f6fed",
    "version": "1.3",
    "origin": "weighin",
    "permissions": {
      "device-storage:sdcard": { "access": "readwrite" },
      "bluetooth": {}
    }
  }
}
